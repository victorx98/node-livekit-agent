{
  "uid": "sa2-agent-telemetry-heartbeat",
  "title": "SA2 interview agent telemetry missing",
  "condition": "C",
  "for": "5m",
  "noDataState": "Alerting",
  "execErrState": "Alerting",
  "annotations": {
    "summary": "SA2 agent telemetry heartbeat is missing or stale",
    "description": "Check agent-sa2, sa2-alloy, Grafana write authorization, and collector export/refusal counters."
  },
  "labels": {
    "service": "sa2-interview-agent",
    "severity": "warning"
  },
  "isPaused": false,
  "data": [
    {
      "refId": "A",
      "datasourceUid": "grafanacloud-prom",
      "relativeTimeRange": {
        "from": 300,
        "to": 0
      },
      "model": {
        "refId": "A",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "expr": "(time() - max(worker_telemetry_heartbeat_timestamp_seconds{job=\"sa2/sa2-interview-agent\"}) > bool 120) or absent(worker_telemetry_heartbeat_timestamp_seconds{job=\"sa2/sa2-interview-agent\"})",
        "instant": true,
        "range": false,
        "intervalMs": 1000,
        "maxDataPoints": 43200
      }
    },
    {
      "refId": "B",
      "datasourceUid": "__expr__",
      "relativeTimeRange": {
        "from": 0,
        "to": 0
      },
      "model": {
        "refId": "B",
        "datasource": {
          "type": "__expr__",
          "uid": "__expr__"
        },
        "type": "reduce",
        "expression": "A",
        "reducer": "last"
      }
    },
    {
      "refId": "C",
      "datasourceUid": "__expr__",
      "relativeTimeRange": {
        "from": 0,
        "to": 0
      },
      "model": {
        "refId": "C",
        "datasource": {
          "type": "__expr__",
          "uid": "__expr__"
        },
        "type": "threshold",
        "expression": "B",
        "conditions": [
          {
            "evaluator": {
              "type": "gt",
              "params": [
                0.5
              ]
            },
            "operator": {
              "type": "and"
            },
            "reducer": {
              "type": "last",
              "params": []
            },
            "type": "query",
            "query": {
              "params": [
                "C"
              ]
            }
          }
        ]
      }
    }
  ],
  "folderUID": "bf6iv07b0y680a",
  "ruleGroup": "sa2-agent-telemetry",
  "orgID": 1
}
